rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pots/{pot} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
         (request.resource.data.likes == resource.data.get('likes', 0) + 1 ||
          request.resource.data.likes == resource.data.get('likes', 0) - 1));
    }
    
    // FAQ collection: read public, write admin
    match /faq/{faqItem} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Bookings collection: create public, read/write/delete admin
    match /bookings/{booking} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }
    
    // Messages collection: create public, read/write/delete admin
    match /messages/{message} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }
    
    // About/Bio collection: read public, write admin
    match /about/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
